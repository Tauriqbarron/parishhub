# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parish_db

# Security
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Google OAuth (for authentication)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Single-user authorization (only this email can access the app)
AUTHORIZED_EMAIL=your-email@gmail.com

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=your-auth-secret-min-32-chars

# Auth.js URL (Production: https://yourdomain.com)
AUTH_URL=https://yourdomain.com

# SvelteKit Origin (Production: https://yourdomain.com)
ORIGIN=https://yourdomain.com

# CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Production Deployment (Nginx/TLS)
DOMAIN_NAME=yourdomain.com
EMAIL_FOR_LETS_ENCRYPT=your-email@example.com
